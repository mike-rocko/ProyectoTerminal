# ============================================
# TUTOR IA - CONFIGURACIÓN DE ENTORNO
# ============================================
# Copia este archivo a .env y completa con tus credenciales

# Base de Datos PostgreSQL (Supabase o local)
DATABASE_URL=postgresql://user:password@localhost:5432/tutor_ia_dev

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Google AI (Gemini) - https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# Google Cloud Storage (opcional, para producción)
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=

# JWT Secret (genera uno: openssl rand -hex 32)
SECRET_KEY=tu_secret_key_aqui_debe_ser_muy_largo_y_aleatorio

# LangSmith (opcional, para debugging) - https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tutor-ia
LANGCHAIN_TRACING_V2=false

# Desarrollo
DB_ECHO=false
