# Variables de entorno para producción (Cloud Run)
# ⚠️ NO commitear este archivo con valores reales

# === Google Cloud ===
GCP_PROJECT_ID=tu-proyecto-id
GCP_REGION=us-central1

# === Base de Datos (Supabase) ===
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# === Redis (Upstash) ===
# Formato: redis://default:password@host:port
REDIS_URL=redis://default:PASSWORD@xxxx.upstash.io:6379

# === Google AI (Gemini) ===
# Obtener en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# === JWT Security ===
# Generar con: openssl rand -hex 32
SECRET_KEY=tu_secret_key_muy_largo_y_seguro

# === Aplicación ===
ENVIRONMENT=production
DEBUG=false

# === URLs de servicios (se obtienen después del deploy) ===
# BACKEND_URL=https://tutor-ia-backend-xxxxx.run.app
# FRONTEND_URL=https://tutor-ia-frontend-xxxxx.run.app
