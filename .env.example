# ===========================================
# Variables de Entorno - Tutor IA
# ===========================================
# Copia este archivo a .env y configura los valores

# Entorno
ENVIRONMENT=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres_dev@postgres:5432/tutor_ia

# Redis
REDIS_URL=redis://redis:6379

# Google AI (Gemini)
GOOGLE_API_KEY=tu_api_key_aqui

# JWT Autenticación
JWT_SECRET_KEY=tu_secret_key_super_segura_cambiar_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LangSmith (opcional - para debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tutor-ia
